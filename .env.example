# Copy to .env. Used by docker compose (env_file) and by
# `npm -w backend start` (node --env-file-if-exists=../.env).

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=8080

# Optional bearer token for /api/* (everything except /api/health).
# Leave empty to disable (e.g. when an access proxy such as Cloudflare Access
# already authenticates every request in front of this server).
API_TOKEN=

# ── Evolution API ────────────────────────────────────────────────────────────
EVOLUTION_BASE=https://evolution.example.com
EVOLUTION_INSTANCE=MyInstance
EVOLUTION_APIKEY=changeme

# Relay Evolution websocket events to clients via GET /api/events (SSE).
# Requires WEBSOCKET_ENABLED=true on the Evolution server.
EVENTS_ENABLED=true

# ── Sending behavior ─────────────────────────────────────────────────────────
# Random delay between consecutive sends of a job, in seconds.
DELAY_MIN=1
DELAY_MAX=3

# How many times a single recipient send is attempted before it counts as failed.
SEND_MAX_ATTEMPTS=3

# ── Cold-contact cap ─────────────────────────────────────────────────────────
# Rations FIRST CONTACT only. Recipients this line already has a conversation
# with, and groups, are never counted — capping conversations you are already in
# would break the day job without touching the risk, which comes from
# unsolicited first messages that recipients report.
#
# The ceiling starts at COLD_WARMUP_START and doubles for each earlier day the
# line actually did cold outreach, up to COLD_DAILY_CAP. A number with no bulk
# history that suddenly reaches hundreds of strangers is the exact anomaly
# WhatsApp acts on.
COLD_CAP_ENABLED=true
COLD_DAILY_CAP=50
COLD_WARMUP_START=10
# Rolling window (days) the ramp counts active days over; also the cold-send
# retention. A quiet stretch longer than this drops the earned ceiling.
COLD_RAMP_WINDOW_DAYS=30

# ── Number verification ──────────────────────────────────────────────────────
# Existence lookups run as a BACKGROUND drip, never as a pre-flight burst: a
# campaign does not wait for them, so they can be paced gently. A thousand
# lookups fired off inside a minute is the signature of contact scraping.
VERIFY_ENABLED=true
VERIFY_BATCH_SIZE=10
VERIFY_BATCH_PAUSE_MS=60000
VERIFY_DAILY_CAP=400

# ── Scheduler ────────────────────────────────────────────────────────────────
# How often the server checks for due jobs (milliseconds).
SCHED_POLL_MS=15000

# If a job is overdue by more than this many minutes when the server looks at
# it (e.g. the server was down), mark it "missed" instead of firing it late.
# 0 = always fire overdue jobs.
MAX_OVERDUE_MIN=0

# ── v2.4 features (all editable live in the Settings UI, which overrides these) ──
# Recurring jobs are opt-in: while false, repeat rules are rejected at save
# time and finished occurrences are never rolled forward.
RECURRING_ENABLED=false

# Quiet hours: due scheduled jobs wait for the window's end ("Send now" bypasses).
QUIET_ENABLED=false
QUIET_START=21:00
QUIET_END=08:00

# Auto opt-out: an incoming direct message that exactly matches a keyword
# blacklists the sender (managed from the Blacklist page).
OPTOUT_ENABLED=false
OPTOUT_KEYWORDS=STOP, הסר
# Confirmation message sent before blacklisting; empty sends nothing.
OPTOUT_REPLY=

# ── Web Push (mobile notifications) ──────────────────────────────────────────
# The VAPID keypair is generated and persisted in the DB on first boot — no key
# config needed. This is only the "sub" contact claim push services may read;
# a real mailto:/https: is polite but optional.
# VAPID_SUBJECT=mailto:admin@webchat.local

# ── Paths (defaults are right for docker; override for bare-metal setups) ────
# STATIC_DIR=../frontend/dist
# DB_PATH=./data/webchat.db

# Timezone the server reads clock times in (quiet hours, a campaign's sending
# window). Leave it and the container runs on UTC.
TZ=Asia/Jerusalem
